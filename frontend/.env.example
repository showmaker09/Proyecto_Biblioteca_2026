# URL base que usa el navegador. "/api" pasa por el proxy de Vite (evita CORS y conserva cookies de sesión)
VITE_API_URL=/api
# Destino real de la API para el proxy de Vite (local o despliegue remoto como Render)
API_PROXY_TARGET=http://127.0.0.1:8000
# true = usa datos falsos locales, sin necesitar backend
VITE_USAR_MOCKS=false
