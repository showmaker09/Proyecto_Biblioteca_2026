{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "BaseDatos": "Biblioteca_Ingenieria"
  },
  "Sesion": {
    "Emisor": "biblioteca-api",
    "Audiencia": "biblioteca-web",
    "MinutosToken": 15,
    "DiasRefresco": 7,
    "CookieSegura": true,
    "RutaCookie": "/auth"
  },
  "Limites": {
    "Lectura": 120,
    "Autenticacion": 5,
    "Sesion": 30,
    "Escritura": 20
  }
}
